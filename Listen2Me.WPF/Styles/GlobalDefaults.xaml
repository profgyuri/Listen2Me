<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontFamily}"/>
        <Setter Property="FontSize" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}"/>
        <Setter Property="FontStyle" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontStyle}"/>
        <Setter Property="FontWeight" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontWeight}"/>
        <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Background}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Mid}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}"/>
        <Setter Property="Padding" Value="4 2"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Light}"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource Brush.Accent.Light}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>