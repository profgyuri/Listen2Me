<UserControl x:Class="Listen2Me.WPF.Views.Layouts.TagEditorLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:layouts="clr-namespace:Listen2Me.MVVM.ViewModels.Layouts;assembly=Listen2Me.MVVM"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance layouts:TagEditorLayoutViewModel}"
             d:DesignHeight="300" d:DesignWidth="500">
    <Grid RowDefinitions="Auto, *, Auto">
        <ToolBarTray Grid.Row="0"
                     Background="{DynamicResource Brush.Background.Primary}">
            <ToolBar Style="{StaticResource MaterialDesignToolBar}" 
                     Background="{DynamicResource Brush.Background.Primary}">
                <Button Content="{materialDesign:PackIcon Kind=DatabaseAdd, Size=16}" ToolTip="Add Songs from the Database"
                        Command="{Binding AddSongsFromDbCommand}"/>
                <Button Content="{materialDesign:PackIcon Kind=FolderAdd, Size=16}" ToolTip="Add Songs from a Folder"
                        Command="{Binding AddSongsFromFolderCommand}"/>
                <Button Content="{materialDesign:PackIcon Kind=Clear, Size=16}" ToolTip="Clear All Items from the Grid"
                        Command="{Binding ClearGridCommand}"/>
                <Button Content="Move..." ToolTip="Move selected files to a different folder."
                        Command="{Binding MoveFilesCommand}"/>
            </ToolBar>
        </ToolBarTray>
        <DataGrid x:Name="SongGrid" Grid.Row="1" Style="{StaticResource TagEditorDataGrid}"
                  ItemsSource="{Binding SongView}"
                  SelectionChanged="SongGrid_OnSelectionChanged">
            <DataGrid.Resources>
                <!-- These style settings only work here 🙃-->
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Style.Triggers>
                        <Trigger Property="DataGridCell.IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary.Light}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Mid}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Genre" Binding="{Binding Genre}"/>
                <DataGridTextColumn Header="BPM" Binding="{Binding Bpm}"/>
                <DataGridTextColumn Header="Bitrate" Binding="{Binding Bitrate}"/>
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding LengthBytes}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last Write" Binding="{Binding LastWrite}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Grid.Row="2" materialDesign:HintAssist.Hint="Filter"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
