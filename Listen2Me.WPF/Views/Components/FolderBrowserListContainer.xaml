<UserControl x:Class="Listen2Me.WPF.Views.Components.FolderBrowserListContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:Listen2Me.WPF.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border Padding="8 4" Margin="8"
            Background="{StaticResource Brush.Background.Secondary.Light}" CornerRadius="8">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Grid.Row="0" Text="{Binding Header, 
                       RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ListView Margin="0 8 0 0" SelectionMode="Single"
                          ItemsSource="{Binding ItemsSource,
                            RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}"
                          SelectedItem="{Binding SelectedItem,
                            RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_OnMouseDoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
