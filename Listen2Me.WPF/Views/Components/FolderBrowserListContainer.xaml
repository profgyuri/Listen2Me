<UserControl x:Class="Listen2Me.WPF.Views.Components.FolderBrowserListContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:Listen2Me.WPF.Views.Components"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Border Padding="8 4" Margin="8"
            Background="{StaticResource Brush.Background.Secondary.Light}" CornerRadius="8">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Grid.Row="0" Text="{Binding Header, 
                       RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}"/>
            <ListView Grid.Row="1" Margin="0 8 0 0" SelectionMode="Single"
                      ItemsSource="{Binding ItemsSource,
                            RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}"
                      SelectedItem="{Binding SelectedItem,
                            RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_OnMouseDoubleClick"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type system:String}">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Text="{Binding}" Grid.Column="0" Grid.Row="0"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Grid.Row="0" 
                                    Style="{StaticResource FolderBrowserListItemButton}"
                                    HorizontalAlignment="Right"
                                    Content="{materialDesign:PackIcon Kind=BookmarkOutline}"
                                    ToolTip="Add to Bookmarks"
                                    Command="{Binding AddBookmarkCommand,
                                        RelativeSource={RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}}"
                                    CommandParameter="{Binding}">
                                <Button.Visibility>
                                    <MultiBinding Converter="{StaticResource BookmarkableVisibilityConverter}">
                                        <Binding Path="IsBookmarkable" 
                                                 RelativeSource="{RelativeSource AncestorType={x:Type components:FolderBrowserListContainer}}"/>
                                        <Binding/>
                                    </MultiBinding>
                                </Button.Visibility>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
