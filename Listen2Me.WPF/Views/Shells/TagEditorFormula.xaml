<Window x:Class="Listen2Me.WPF.Views.Shells.TagEditorFormula"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shells="clr-namespace:Listen2Me.MVVM.ViewModels.Shells;assembly=Listen2Me.MVVM"
        xmlns:components="clr-namespace:Listen2Me.WPF.Views.Components"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance shells:TagEditorFormulaViewModel}"
        WindowStyle="None"
        Background="{DynamicResource Brush.Background.Primary}"
        Foreground="{DynamicResource Brush.Foreground.Primary}"
        Title="TagEditorFormula" Height="232" Width="300">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="WindowChrome" CaptionHeight="32" />
    </WindowChrome.WindowChrome>
    
    <Grid RowDefinitions="32, *">
        <components:TitleBar Grid.Row="0" HideButtons="True"/>
        
        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *, Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Format string: "/>
                <!-- Either the generated file name or the one being read for metadata -->
                <TextBlock Margin="10 0 0 0" Text="{Binding FileName}"/>
            </StackPanel>
        
            <TextBox Grid.Row="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Padding="4 2"
                     Foreground="{DynamicResource Brush.Foreground.Primary}"
                     BorderBrush="{DynamicResource Brush.Accent.Mid}"
                     Text="{Binding Formula}"/>
        
            <!-- This ItemsControl should contain the read tags if the formula for the first selected song is correct. -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding ReadTags}"/>
        
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Ok" Width="75" Margin="16 0"
                        Click="OkButton_OnClick"/>
                <Button Content="Cancel" Width="75"
                        Click="CancelButton_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
